{
  "name": "slashloop-mcp",
  "version": "1.2.0",
  "description": "Viral short-form video research MCP server — remote HTTP (Vercel + Supabase OAuth).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "remote:dev": "bun --watch remote/dev.ts",
    "seed": "bun src/seed.ts",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "postinstall": "prisma generate --schema prisma/schema.prisma || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "6.11.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.0",
    "prisma": "6.11.1",
    "stripe": "^22.3.2",
    "uuid": "^11.1.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.14",
    "@types/node": "^22.15.21",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.8.26",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/man0l/slashloop.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tiktok",
    "shorts",
    "reels",
    "content-research"
  ]
}
