{
  "name": "slashloop-mcp",
  "version": "1.2.0",
  "description": "Viral short-form video research MCP server — track sources, find outliers, run Gemini video analysis, generate hooks/briefs. Local stdio (Claude Code) or remote OAuth HTTP.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "slashloop-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/empty.db",
    "prompts",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "remote:dev": "bun --watch remote/dev.ts",
    "seed": "bun src/seed.ts",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "prepack": "npm run build && node -e \"const p=require('./package.json'); if(p.name!=='slashloop-mcp') throw new Error('refuse publish: package name must be slashloop-mcp');\"",
    "postinstall": "prisma generate --schema prisma/schema.prisma || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "6.11.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.0",
    "prisma": "6.11.1",
    "uuid": "^11.1.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.14",
    "@types/node": "^22.15.21",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.8.26",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/man0l/slashloop.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tiktok",
    "shorts",
    "reels",
    "content-research"
  ]
}
