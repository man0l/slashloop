// Edit the canonical schema, then re-run the script (see header there).
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DB_URL")
}

/// Mirror of a Supabase auth user (id = the JWT `sub`, i.e. Workspace.ownerId).
/// Populated by the Supabase→D1 data migration and refreshed at login. Exists
/// because the weekly digest resolves the owner's email without joining into
/// Supabase's `auth` schema (src/lib/digest.ts) — once the app runs on D1 there
/// is no auth schema to read. Phase 4 (Cloudflare-native auth) turns this into
/// the identity source of truth.
model User {
  id        String   @id
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id                   String   @id @default(uuid())
  /// Supabase auth user id (JWT `sub`). Null = local single-tenant workspace.
  /// Not unique — a user may own several workspaces (see WORKSPACE_LIMITS in
  /// src/lib/workspaces.ts), each billed independently.
  ownerId              String?
  name                 String   @default("Default")
  /// Legacy: reported by get_usage but no longer enforced. Superseded by the
  /// planCredits/packCredits ledger below (see src/lib/credits.ts). Kept so
  /// existing rows/tools don't break; do not wire new enforcement to this.
  monthlyBudgetCents   Int      @default(5000)
  autoAnalyzeRulesJson String   @default("{}")
  analysisConfigJson   String   @default("{\"backend\":\"gemini-native\",\"fallback\":\"gemini-text\",\"geminiModel\":\"gemini-3.5-flash\",\"fallbackModel\":\"gemini-3.5-flash-lite\"}")
  failureCountsJson    String   @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // --- billing ---
  /// free | creator | pro. Server-controlled — never set this from a
  /// user-facing tool input. Changed only by the Stripe webhook (Phase 2)
  /// or a trusted admin path. Billing is per-workspace, not per-seat — a
  /// user with multiple workspaces pays for each independently. The number
  /// of workspaces a user may own is gated by WORKSPACE_LIMITS in
  /// src/lib/workspaces.ts, keyed off the highest plan already held across
  /// their workspaces (see docs/pricing-research.md §4c).
  planKey              String    @default("free")
  /// Resets to the plan's allotment on each billing-period renewal.
  planCredits          Int       @default(300)
  /// Purchased top-up credits. Never expire, never reset. Drained only after
  /// planCredits is exhausted (see debitCredits in src/lib/credits.ts).
  packCredits          Int       @default(0)
  billingStatus        String    @default("active") // active | past_due | canceled
  periodStart          DateTime?
  periodEnd            DateTime?
  autoTopUp            Boolean   @default(false)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// Live and test mode each have their own Customer/Subscription id space
  /// in Stripe — a live-mode id is meaningless (and errors) against a test
  /// key. These mirror the two fields above for STRIPE_MODE=test, so
  /// flipping modes on an already-onboarded workspace doesn't try to reuse
  /// a live customer with a test key. See customerIdField() in
  /// src/lib/stripe.ts.
  stripeTestCustomerId     String? @unique
  stripeTestSubscriptionId String? @unique

  // --- media retention ---
  /// Days to keep stored cover images / MP4s before the retention sweeper
  /// deletes them (api/cron/media-retention.ts). User-writable via
  /// update_settings, but every write goes through validateRetentionDays()
  /// in src/lib/retention.ts and is rejected above the plan ceiling —
  /// retention is a COGS lever, same class of field as monthlyBudgetCents.
  /// See docs/media-storage-plan.md §1.4.
  thumbRetentionDays   Int       @default(3)
  mediaRetentionDays   Int       @default(3)

  // --- weekly digest ---
  /// Opt-out for the weekly outlier digest (api/cron/digest.ts). On by
  /// default — the digest is the retention engine, not marketing.
  digestEnabled        Boolean   @default(true)
  /// Where the digest goes. Null = the owner's auth.users email. Set from
  /// the site's email-settings page; one owner may own several workspaces,
  /// but all of an owner's due digests combine into ONE email to this box.
  digestEmail          String?
  /// When the last digest was built+sent. Doubles as the "new outliers"
  /// watermark and the cron's idempotency gate (≥7 days since = due).
  lastDigestAt         DateTime?
  /// Last built digest payload; get_digest serves this between runs.
  digestJson           String?

  sources              Source[]
  boards               Board[]
  hookTests            HookTest[]
  usageLogs            UsageLog[]
  autoAnalyzeRuns      AutoAnalyzeRun[]
  creditLedger         CreditLedger[]
  mediaJobs            MediaJob[]
  suggestionDismissals SuggestionDismissal[]

  @@index([ownerId])
}

/// Append-only audit trail for credit grants/debits. The Workspace row holds
/// the live balance (for atomic conditional updates); this table explains
/// how it got there. Unique on [workspaceId, refId] doubles as the
/// idempotency check — see debitCredits/refundCredits in src/lib/credits.ts.
model CreditLedger {
  id           String   @id @default(uuid())
  workspaceId  String
  delta        Int // positive = grant, negative = debit
  bucket       String // plan | pack
  reason       String // tool_call | usage_settlement | call_failed | subscription_renewal | pack_purchase | adjustment
  tool         String? // e.g. refresh_source, analyze_video
  balanceAfter Int // planCredits + packCredits after this entry
  refId        String // idempotency key (op id, or Stripe event id in Phase 2)
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, refId])
  @@index([workspaceId, createdAt])
}

/// Idempotency gate for the Stripe webhook (id = Stripe event id). Inserted
/// in the same transaction as the event's Workspace/CreditLedger mutation —
/// if the insert fails on a duplicate id, the whole transaction (including
/// the mutation) rolls back, so a Stripe retry after a transient failure
/// reprocesses cleanly instead of silently no-op'ing. See
/// api/stripe/webhook.ts.
model StripeEvent {
  id          String   @id
  type        String
  payloadJson String
  processedAt DateTime @default(now())
}

/// A workspace's "no thanks" on an AI-suggested hashtag/keyword/creator
/// (src/lib/suggestions.ts) — excluded from both the candidates shown on a
/// future suggest run and the "already considered" list sent to Gemini, so
/// a rejected suggestion doesn't keep coming back.
model SuggestionDismissal {
  id          String   @id @default(uuid())
  workspaceId String
  sourceType  String // hashtag | keyword | creator
  /// Normalized the same way the tracked-sources dedupe is: lowercase, no
  /// leading # or @.
  query       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, sourceType, query])
  @@index([workspaceId])
}

model Source {
  id               String    @id @default(uuid())
  workspaceId      String
  platform         String // tiktok | reels | shorts
  sourceType       String // creator | keyword | hashtag
  query            String
  language         String    @default("en")
  videoLimit       Int       @default(50)
  refreshSchedule  String    @default("manual") // manual | daily | weekly
  isActive         Boolean   @default(true)
  /// True when this creator source is the workspace owner's own TikTok.
  /// Scoring already uses the creator's median, so the gallery reads
  /// "your video vs your baseline" instead of niche outliers. At most one
  /// self source per workspace (enforced in sources-service, not a unique
  /// index — toggling off must stay a plain update).
  isSelf           Boolean   @default(false)
  nicheTag         String?
  createdAt        DateTime  @default(now())
  lastRefreshedAt  DateTime?
  consecutiveFails Int       @default(0)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  videos      Video[]
  refreshRuns RefreshRun[]

  @@index([workspaceId])
  @@index([platform])
  @@index([isActive])
}

model Video {
  id               String   @id @default(uuid())
  sourceId         String
  platform         String // tiktok | reels | shorts
  externalId       String
  url              String
  thumbnailUrl     String   @default("")
  creatorHandle    String
  creatorFollowers Int?
  caption          String   @default("")
  postedAt         DateTime
  views            Int      @default(0)
  likes            Int      @default(0)
  comments         Int      @default(0)
  shares           Int?
  saves            Int?
  durationSec      Int?
  transcript       String?
  transcriptSource String   @default("none") // captions | asr | none
  rawJson          String   @default("{}")
  scrapedAt        DateTime @default(now())

  /// True for a video pulled purely to keep a creator's outlier baseline
  /// fresh (src/scoring.ts rescoreStaleTooFresh, via runRefresh's
  /// sourceTypeOverride/queryOverride) rather than found by a source the
  /// workspace is actually tracking. Persisted so the same creator isn't
  /// re-scraped on every stale-check pass, but excluded from the Gallery and
  /// from a Source's video count/preview — it isn't "content", it's baseline
  /// data. Cleared (promoted to visible) the moment a real, non-override
  /// refresh legitimately discovers the same video (src/lib/refresh.ts).
  isBaselineSample Boolean  @default(false)

  // --- stored media (docs/media-storage-plan.md) ---
  /// Object key in the public `thumbs` bucket. Null = not stored; the feed
  /// falls back to thumbnailUrl above, which stays as provenance and is the
  /// only way to re-ingest.
  thumbKey         String?
  /// none | stored | expired | failed. 'none' means nothing was attempted
  /// (storage off, or a non-TikTok platform); 'failed' means it was tried.
  thumbStatus      String   @default("none")
  thumbStoredAt    DateTime?
  /// Object key in the private `media` bucket. Reached via signed URL only.
  mediaKey         String?
  mediaStatus      String   @default("none")
  mediaBytes       Int?
  mediaStoredAt    DateTime?
  /// Gemini Files API handle for this video's MP4 (docs/media-storage-plan.md
  /// §2.2). The API keeps an upload ~48h; inside that window a re-analysis
  /// needs no upload at all, which is the slowest leg after the Apify download.
  /// Kept on Video rather than Analysis (as §2.2 sketched) because it describes
  /// the video, not a run — exactly like mediaKey above, and queried the same way.
  geminiFileUri       String?
  geminiFileName      String?
  geminiFileExpiresAt DateTime?

  /// TikTok sound / original audio, when the scrape included musicMeta.
  soundId          String?
  soundTitle       String?
  soundAuthor      String?

  source       Source       @relation(fields: [sourceId], references: [id])
  score        Score?
  analyses     Analysis[]
  hooks        Hook[]
  swipeEntries SwipeEntry[]
  ideas        Idea[]
  hookTests    HookTest[]

  /// Fan-out from a shared multi-tenant scrape can be applied twice — by two
  /// worker containers racing, or (Phase B) by replaying a cached result.
  /// The constraint is what makes that idempotent instead of duplicating rows;
  /// src/lib/refresh.ts catches the violation and updates stats instead.
  @@unique([sourceId, platform, externalId])
  @@index([sourceId])
  @@index([platform])
  @@index([creatorHandle])
  @@index([postedAt])
  @@index([views])
  // Retention sweeper scans by stored-at within status; both are covered.
  @@index([thumbStatus, thumbStoredAt])
  @@index([mediaStatus, mediaStoredAt])
  @@index([soundId])
}

/// One Apify run per canonical query across worker containers. A TTL row
/// rather than pg_advisory_lock: the workers talk to the Supabase pooler in
/// transaction pooling mode, where a session-level lock can be released on a
/// different backend and leak. See src/lib/jobs.ts acquireCanonicalLock.
model CanonicalScrapeLock {
  /// canonicalKey(platform, sourceType, normalizedQuery)
  key       String   @id
  lockedBy  String
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

