/// Work that cannot finish inside one request. See docs/media-storage-plan.md §3.3.
///
/// gemini-native has to download the MP4, upload it, wait for Gemini to process
/// it and then generate — which does not fit the 60s function ceiling, and that
/// ceiling is not raisable on the current Vercel plan. So analyze_video records
/// the intent here and a worker invocation does the work on its own budget.
///
/// Claim protocol: the worker flips queued -> running with startedAt in a single
/// conditional UPDATE, so two workers racing the same row cannot both win. A
/// worker killed mid-flight leaves the row in `running` forever, so the daily
/// sweeper returns rows stuck past a threshold to `queued`. attempts guards the
/// resulting retry loop.
model MediaJob {
  id          String    @id @default(uuid())
  workspaceId String
  /// Null for source-scoped kinds (refresh) and for discover probes (no
  /// source exists yet). For every kind except discover, exactly one of
  /// videoId/sourceId is set — enforced by MediaJob_one_target in
  /// supabase/migrations, since Prisma cannot express that CHECK.
  videoId     String?
  /// Set for source-scoped kinds. A refresh targets a Source, not a Video.
  sourceId    String?
  /// analyze | fetch | refresh | rescore | thumb | discover. Named rather than
  /// implied so work like this shares the queue instead of growing a second one.
  kind        String    @default("analyze")
  /// Hard wall clock for callers waiting on this job. await_job refuses to
  /// report shouldKeepPolling once past it, so a waiter terminates even if the
  /// worker never reports back. Null means no deadline.
  deadlineAt  DateTime?
  /// Credits debited at enqueue. reclaimStuckJobs refunds THIS amount rather
  /// than assuming the analyze price — a refresh pre-auth scales with
  /// videoLimit, so a fixed refund would be wrong in both directions.
  preAuthCredits Int?
  /// queued | running | done | failed
  status      String    @default("queued")
  attempts    Int       @default(0)
  lastError   String?
  /// Call options captured at enqueue time (e.g. forceBackend), applied by the
  /// worker. The request that chose them is long gone by the time it runs.
  payloadJson String    @default("{}")
  /// Credit pre-authorisation reference. The caller is debited at enqueue, so
  /// the worker owns the refund when a job fails terminally.
  opId        String?
  /// Set on success, so get_video can point at the result without a join.
  analysisId  String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  // The worker's claim query: oldest queued row first.
  @@index([status, createdAt])
  // get_video asks "is there a job for this video right now?"
  @@index([videoId, status])
  @@index([workspaceId])
}

/// One-row incident marker for the scraping-failure email alert
/// (src/lib/scrape-alert.ts). Written only via raw SQL so the
/// notifiedAt NULL -> set flip is atomic across the two worker containers:
/// notifiedAt NULL = armed (next scrape outage sends exactly one email), set =
/// incident open (repeat failures stay silent). The first successful scrape
/// re-arms it. Never touched through the Prisma client — no relation, no
/// queries; the model exists so schema.prisma stays the schema's source of
/// truth (see README "Schema changes").
model ScrapeAlertState {
  id         String    @id @default("scrape")
  notifiedAt DateTime?
  lastError  String?
  updatedAt  DateTime  @default(now())
}
