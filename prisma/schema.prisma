generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id                   String   @id @default(uuid())
  /// Supabase auth user id (JWT `sub`). Null = local single-tenant workspace.
  ownerId              String?  @unique
  name                 String   @default("Default")
  /// Legacy: reported by get_usage but no longer enforced. Superseded by the
  /// planCredits/packCredits ledger below (see src/lib/credits.ts). Kept so
  /// existing rows/tools don't break; do not wire new enforcement to this.
  monthlyBudgetCents   Int      @default(5000)
  autoAnalyzeRulesJson String   @default("{}")
  analysisConfigJson   String   @default("{\"backend\":\"gemini-native\",\"fallback\":\"gemini-text\",\"geminiModel\":\"gemini-3.5-flash\"}")
  failureCountsJson    String   @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // --- billing ---
  /// free | creator | pro. Server-controlled — never set this from a
  /// user-facing tool input. Changed only by the Stripe webhook (Phase 2)
  /// or a trusted admin path. No multi-seat/"agency" tier yet — ownerId
  /// is a unique 1:1 with the authenticated user, so there's no seat
  /// model to sell one into (see docs/pricing-research.md §4c).
  planKey              String    @default("free")
  /// Resets to the plan's allotment on each billing-period renewal.
  planCredits          Int       @default(300)
  /// Purchased top-up credits. Never expire, never reset. Drained only after
  /// planCredits is exhausted (see debitCredits in src/lib/credits.ts).
  packCredits          Int       @default(0)
  billingStatus        String    @default("active") // active | past_due | canceled
  periodStart          DateTime?
  periodEnd            DateTime?
  autoTopUp            Boolean   @default(false)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// Live and test mode each have their own Customer/Subscription id space
  /// in Stripe — a live-mode id is meaningless (and errors) against a test
  /// key. These mirror the two fields above for STRIPE_MODE=test, so
  /// flipping modes on an already-onboarded workspace doesn't try to reuse
  /// a live customer with a test key. See customerIdField() in
  /// src/lib/stripe.ts.
  stripeTestCustomerId     String? @unique
  stripeTestSubscriptionId String? @unique

  // --- media retention ---
  /// Days to keep stored cover images / MP4s before the retention sweeper
  /// deletes them (api/cron/media-retention.ts). User-writable via
  /// update_settings, but every write goes through validateRetentionDays()
  /// in src/lib/retention.ts and is rejected above the plan ceiling —
  /// retention is a COGS lever, same class of field as monthlyBudgetCents.
  /// See docs/media-storage-plan.md §1.4.
  thumbRetentionDays   Int       @default(3)
  mediaRetentionDays   Int       @default(3)

  sources         Source[]
  boards          Board[]
  usageLogs       UsageLog[]
  autoAnalyzeRuns AutoAnalyzeRun[]
  creditLedger    CreditLedger[]
  mediaJobs       MediaJob[]
}

/// Append-only audit trail for credit grants/debits. The Workspace row holds
/// the live balance (for atomic conditional updates); this table explains
/// how it got there. Unique on [workspaceId, refId] doubles as the
/// idempotency check — see debitCredits/refundCredits in src/lib/credits.ts.
model CreditLedger {
  id           String   @id @default(uuid())
  workspaceId  String
  delta        Int // positive = grant, negative = debit
  bucket       String // plan | pack
  reason       String // tool_call | usage_settlement | call_failed | subscription_renewal | pack_purchase | adjustment
  tool         String? // e.g. refresh_source, analyze_video
  balanceAfter Int // planCredits + packCredits after this entry
  refId        String // idempotency key (op id, or Stripe event id in Phase 2)
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, refId])
  @@index([workspaceId, createdAt])
}

/// Idempotency gate for the Stripe webhook (id = Stripe event id). Inserted
/// in the same transaction as the event's Workspace/CreditLedger mutation —
/// if the insert fails on a duplicate id, the whole transaction (including
/// the mutation) rolls back, so a Stripe retry after a transient failure
/// reprocesses cleanly instead of silently no-op'ing. See
/// api/stripe/webhook.ts.
model StripeEvent {
  id          String   @id
  type        String
  payloadJson String
  processedAt DateTime @default(now())
}

model Source {
  id               String    @id @default(uuid())
  workspaceId      String
  platform         String // tiktok | reels | shorts
  sourceType       String // creator | keyword | hashtag
  query            String
  language         String    @default("en")
  videoLimit       Int       @default(50)
  refreshSchedule  String    @default("manual") // manual | daily | weekly
  isActive         Boolean   @default(true)
  nicheTag         String?
  createdAt        DateTime  @default(now())
  lastRefreshedAt  DateTime?
  consecutiveFails Int       @default(0)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  videos      Video[]
  refreshRuns RefreshRun[]

  @@index([workspaceId])
  @@index([platform])
  @@index([isActive])
}

model Video {
  id               String   @id @default(uuid())
  sourceId         String
  platform         String // tiktok | reels | shorts
  externalId       String
  url              String
  thumbnailUrl     String   @default("")
  creatorHandle    String
  creatorFollowers Int?
  caption          String   @default("")
  postedAt         DateTime
  views            Int      @default(0)
  likes            Int      @default(0)
  comments         Int      @default(0)
  shares           Int?
  saves            Int?
  durationSec      Int?
  transcript       String?
  transcriptSource String   @default("none") // captions | asr | none
  rawJson          String   @default("{}")
  scrapedAt        DateTime @default(now())

  // --- stored media (docs/media-storage-plan.md) ---
  /// Object key in the public `thumbs` bucket. Null = not stored; the feed
  /// falls back to thumbnailUrl above, which stays as provenance and is the
  /// only way to re-ingest.
  thumbKey         String?
  /// none | stored | expired | failed. 'none' means nothing was attempted
  /// (storage off, or a non-TikTok platform); 'failed' means it was tried.
  thumbStatus      String   @default("none")
  thumbStoredAt    DateTime?
  /// Object key in the private `media` bucket. Reached via signed URL only.
  mediaKey         String?
  mediaStatus      String   @default("none")
  mediaBytes       Int?
  mediaStoredAt    DateTime?
  /// Gemini Files API handle for this video's MP4 (docs/media-storage-plan.md
  /// §2.2). The API keeps an upload ~48h; inside that window a re-analysis
  /// needs no upload at all, which is the slowest leg after the Apify download.
  /// Kept on Video rather than Analysis (as §2.2 sketched) because it describes
  /// the video, not a run — exactly like mediaKey above, and queried the same way.
  geminiFileUri       String?
  geminiFileName      String?
  geminiFileExpiresAt DateTime?

  source       Source       @relation(fields: [sourceId], references: [id])
  score        Score?
  analyses     Analysis[]
  hooks        Hook[]
  swipeEntries SwipeEntry[]
  ideas        Idea[]

  @@index([sourceId])
  @@index([platform])
  @@index([creatorHandle])
  @@index([postedAt])
  @@index([views])
  // Retention sweeper scans by stored-at within status; both are covered.
  @@index([thumbStatus, thumbStoredAt])
  @@index([mediaStatus, mediaStoredAt])
}

model Baseline {
  id            String   @id @default(uuid())
  creatorHandle String
  platform      String
  medianViews   Float
  sampleSize    Int
  computedAt    DateTime @default(now())

  @@unique([creatorHandle, platform])
  @@index([creatorHandle])
}

model Score {
  videoId      String   @id
  outlierScore Float
  scoreType    String   @default("actual") // actual | estimated
  explanation  String
  scoredAt     DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id])

  @@index([outlierScore])
}

model Analysis {
  id            String   @id @default(uuid())
  videoId       String
  schemaVersion String   @default("v3")
  analysisJson  String // JSON string of the analysis
  analysisBasis String // video | video+transcript | frames+transcript | frames+caption | transcript+thumbnail | transcript-only | thumbnail+caption | caption+metadata-only
  backend       String   @default("gemini-native") // gemini-native | frames | hybrid
  model         String   @default("gemini-3.5-flash")
  costCents     Int      @default(0)
  createdAt     DateTime @default(now())

  video  Video   @relation(fields: [videoId], references: [id])
  hooks  Hook[]
  ideas  Idea[]
  briefs Brief[]

  @@index([videoId])
}

model Hook {
  id         String   @id @default(uuid())
  analysisId String?
  videoId    String
  text       String
  hookType   String // POV | curiosity_gap | bold_claim | pattern_interrupt | question | ...
  placement  String // spoken | on_screen | visual
  origin     String   @default("extracted") // extracted | generated
  nicheTag   String?
  createdAt  DateTime @default(now())

  analysis Analysis? @relation(fields: [analysisId], references: [id])
  video    Video     @relation(fields: [videoId], references: [id])

  @@index([hookType])
  @@index([nicheTag])
  @@index([origin])
}

model Board {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id])
  swipeEntries SwipeEntry[]

  @@index([workspaceId])
}

model SwipeEntry {
  id                   String   @id @default(uuid())
  boardId              String
  videoId              String
  analysisSnapshotJson String   @default("{}")
  notes                String   @default("")
  savedAt              DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@unique([boardId, videoId])
  @@index([boardId])
}

model Idea {
  id                  String   @id @default(uuid())
  videoId             String
  analysisId          String?
  transferablePattern String
  whyItWorked         String
  adaptation          String
  status              String   @default("new") // new | briefed | tested | archived
  createdAt           DateTime @default(now())

  video    Video     @relation(fields: [videoId], references: [id])
  analysis Analysis? @relation(fields: [analysisId], references: [id])
  briefs   Brief[]

  @@index([status])
}

model Brief {
  id         String    @id @default(uuid())
  ideaId     String?
  analysisId String
  briefJson  String
  exportedAt DateTime?
  createdAt  DateTime  @default(now())

  analysis Analysis? @relation(fields: [analysisId], references: [id])
  idea     Idea?     @relation(fields: [ideaId], references: [id])
}

model UsageLog {
  id          String   @id @default(uuid())
  workspaceId String
  kind        String // scrape | ai
  provider    String
  units       Int      @default(1)
  costCents   Int      @default(0)
  refId       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([kind])
  @@index([createdAt])
}

model RefreshRun {
  id          String   @id @default(uuid())
  sourceId    String
  itemsPulled Int      @default(0)
  newVideos   Int      @default(0)
  errorsJson  String   @default("[]")
  costCents   Int      @default(0)
  ranAt       DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([ranAt])
}

model AutoAnalyzeRun {
  id             String   @id @default(uuid())
  workspaceId    String
  candidateCount Int      @default(0)
  analyzedCount  Int      @default(0)
  skippedCount   Int      @default(0)
  failedCount    Int      @default(0)
  totalCostCents Int      @default(0)
  batchMode      Boolean  @default(true)
  resultsJson    String   @default("[]")
  ranAt          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([ranAt])
}

/// Work that cannot finish inside one request. See docs/media-storage-plan.md §3.3.
///
/// gemini-native has to download the MP4, upload it, wait for Gemini to process
/// it and then generate — which does not fit the 60s function ceiling, and that
/// ceiling is not raisable on the current Vercel plan. So analyze_video records
/// the intent here and a worker invocation does the work on its own budget.
///
/// Claim protocol: the worker flips queued -> running with startedAt in a single
/// conditional UPDATE, so two workers racing the same row cannot both win. A
/// worker killed mid-flight leaves the row in `running` forever, so the daily
/// sweeper returns rows stuck past a threshold to `queued`. attempts guards the
/// resulting retry loop.
model MediaJob {
  id          String    @id @default(uuid())
  workspaceId String
  /// Null for source-scoped kinds (refresh). Exactly one of videoId/sourceId
  /// is set — enforced by a CHECK constraint in the migration, since Prisma
  /// cannot express "one of these two".
  videoId     String?
  /// Set for source-scoped kinds. A refresh targets a Source, not a Video.
  sourceId    String?
  /// analyze | fetch | refresh. Named rather than implied so work like this
  /// shares the queue instead of growing a second one.
  kind        String    @default("analyze")
  /// Hard wall clock for callers waiting on this job. await_job refuses to
  /// report shouldKeepPolling once past it, so a waiter terminates even if the
  /// worker never reports back. Null means no deadline.
  deadlineAt  DateTime?
  /// Credits debited at enqueue. reclaimStuckJobs refunds THIS amount rather
  /// than assuming the analyze price — a refresh pre-auth scales with
  /// videoLimit, so a fixed refund would be wrong in both directions.
  preAuthCredits Int?
  /// queued | running | done | failed
  status      String    @default("queued")
  attempts    Int       @default(0)
  lastError   String?
  /// Call options captured at enqueue time (e.g. forceBackend), applied by the
  /// worker. The request that chose them is long gone by the time it runs.
  payloadJson String    @default("{}")
  /// Credit pre-authorisation reference. The caller is debited at enqueue, so
  /// the worker owns the refund when a job fails terminally.
  opId        String?
  /// Set on success, so get_video can point at the result without a join.
  analysisId  String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  // The worker's claim query: oldest queued row first.
  @@index([status, createdAt])
  // get_video asks "is there a job for this video right now?"
  @@index([videoId, status])
  @@index([workspaceId])
}
