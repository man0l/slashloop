{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known" },
    { "source": "/oauth/consent", "destination": "/api/consent" },
    { "source": "/login", "destination": "/api/login" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/", "destination": "/api/health" }
  ],
  "functions": {
    "api/mcp.ts": { "maxDuration": 60 }
  }
}
