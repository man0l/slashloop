{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/well-known"
    },
    {
      "source": "/oauth/consent",
      "destination": "/api/consent"
    },
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/gallery",
      "destination": "/api/gallery"
    },
    {
      "source": "/",
      "destination": "/api/health"
    }
  ],
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60
    },
    "api/gallery.ts": {
      "maxDuration": 30
    },
    "api/cron/media-retention.ts": {
      "maxDuration": 60
    },
    "api/jobs/analyze.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/media-retention",
      "schedule": "0 3 * * *"
    }
  ]
}
