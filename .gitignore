prisma/slashloop.db

# Logs
*.log
dev.log
server.log

# OS / editor
.DS_Store
.vscode/
.idea/

# MCP client temp files
.mcp-cache/

# Local gallery HTML preview (bun run preview:gallery)
.preview/

# Third-party Supabase agent skills (fetched by opencode/claude, not project source)
.agents/skills/supabase/
.agents/skills/supabase-postgres-best-practices/
.claude/skills/supabase/
.claude/skills/supabase-postgres-best-practices/
