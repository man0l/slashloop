# Local scratch / temp scripts and diagnostics (never commit)
_tmp_*
_rescore*

# Local Contabo log tailer (SSH host + compose path, not project source)
tail-worker.sh
tail-worker.cmd
tail-worker

# Local screenshots and gallery snapshots (root only)
/gallery-*.png
/gallery-*.md

# Secret-bearing env backups (safety net beyond .env / .env.*.local)
.env.bak
.env.bak.*
.env.vercel.*

# Tooling caches
.playwright-mcp/

# All env files (fallback catch-all beyond the specific .env variants above)
.env*


# ZCode session workspace (plans/handoffs) — never commit or deploy
.zcode/

# The worker env EXAMPLE is placeholder-only — keep it tracked.
!worker/.env.example
