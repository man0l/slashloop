# VPS worker env — same values as the production environment.
# Copy to .env.worker and fill in. `docker run --env-file worker/.env.worker`.
#
# TWO MODES (see docs/cloudflare-migration.md cutover §5):
#   Postgres mode (pre-cutover): set DATABASE_URL (+ DIRECT_URL for migrations).
#   D1 mode (post-cutover):      set DB_DIALECT=sqlite + the D1 trio below.
#     DATABASE_URL is NOT required in D1 mode and is ignored.

# --- Postgres (Supabase pooler) — Postgres mode only, omit in D1 mode ---
# connection_limit should be >= WORKER_CONCURRENCY (jobs persist/score in parallel).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=2
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- D1 over HTTP (Cloudflare API) — D1 mode only, omit in Postgres mode ---
# DB_DIALECT=sqlite switches src/db.ts to the D1 HTTP client. Startup fails
# fast if any of the trio is missing; DATABASE_URL is not consulted.
#DB_DIALECT=sqlite
#D1_ACCOUNT_ID=
#D1_DATABASE_ID=
#D1_API_TOKEN=
# Atomic money paths in D1 mode: multi-statement batches are POSTed to the
# Worker's /internal/raw-batch (one transaction). Without both of these the
# worker still runs, but batches execute WITHOUT atomicity (dev only — the
# worker logs a warning at startup and per batch).
#WORKER_INTERNAL_URL=https://slashloop.<account>.workers.dev
#CRON_SECRET=

# --- Supabase REST (auth/project) + optional Storage fallback ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=service_role_key
STORAGE_MEDIA_BUCKET=slashloop-media
STORAGE_THUMB_BUCKET=slashloop-thumbs
MEDIA_SIGNED_URL_TTL_SECONDS=86400

# --- Cloudflare R2 (preferred media backend when set — same as Vercel) ---
# Baked into the GHCR image by .github/workflows/build-worker-image.yml from
# GitHub secrets/vars. Contabo does not pull these live; it pulls the image.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_THUMB_BUCKET=slashloop-thumbs
R2_MEDIA_BUCKET=slashloop-media
R2_THUMB_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev

# --- AI providers (same as Vercel) ---
OPENROUTER_API_KEY=sk-or-v1-...
# Video model + mode: qwen3.7 is the JSON-capable choice. On the VPS there is
# no 60s ceiling, so raise the per-call timeout and accept full-length clips:
OPENROUTER_VIDEO_MODEL=qwen/qwen3.7-flash
OPENROUTER_VIDEO_MODE=auto
OPENROUTER_VIDEO_TIMEOUT_MS=300000
OPENROUTER_VIDEO_MAX_DURATION_SEC=3600
# Max output tokens for video analysis (4096 default truncates long clips on Gemini).
OPENROUTER_VIDEO_MAX_TOKENS=16384
# Text fallback uses the same OpenRouter key; GEMINI_API_KEY powers google-native.
GEMINI_API_KEY=

# --- Scrapers ---
# apify (default) or proxy. Exclusive — there is no fallback between them.
# Single-video downloads use proxy whenever SCRAPER_PROXY_URL is set.
SCRAPER_PROVIDER=apify
# SCRAPER_PROXY_URL=
# PROXY_TRAFFIC_CAP_GB=1
# PROXY_COST_CENTS_PER_GB=300
# SCRAPER_PROXY_MAX_VIDEO_MB=12
# SCRAPER_PROXY_HEADLESS=0
# SCRAPER_PROXY_COUNTRY=US
# PROXY_CHEAP_API_KEY=
# PROXY_CHEAP_API_SECRET=
# After embed, fetch this many video pages for likes (0 = views only).
# SCRAPER_HYDRATE_STATS=8

# --- Apify ---
APIFY_API_KEY=apify_api_...
APIFY_SPEND_CAP_CENTS=1000
# Leave unset to use the production-proven clockworks~tiktok-scraper (the default).
# Only set APIFY_TIKTOK_ACTOR_ID to try a different/forked actor.
#APIFY_TIKTOK_ACTOR_ID=

# --- Worker behavior ---
# Poll interval when the queue is empty. Default is dialect-aware: 3000 in
# Postgres mode (3000 OK there), 10000 in D1 mode. An explicit value wins in
# both modes. WARNING: 3000 in D1 mode caused cascading timeouts — D1 is
# single-writer with a ~10 qps budget, and per-3s polling from every container
# eats it. The cutover runbook recommends 10000 for D1 (docs/cloudflare-migration.md §5).
WORKER_IDLE_MS=10000
WORKER_RESCORE_EVERY=60
# Jobs drained in parallel. Claims are atomic (SKIP LOCKED on Postgres, the
# single-statement UPDATE..RETURNING claim on D1). In Postgres mode keep this
# <= DB connection_limit; D1 serializes server-side so raising it only adds
# scrape parallelism, not DB throughput.
WORKER_CONCURRENCY=2
# Throttle for BOTH whole-queue recovery sweeps (stuck-claim reclaim +
# never-claimed fail) on the maintenance worker. Whole-queue scans — do not
# lower this in D1 mode. Staggered across containers by a random initial offset.
#WORKER_RECLAIM_INTERVAL_MS=300000
# Proxy-Cheap vendor bandwidth snapshot TTL in ms (default 60000).
# PROXY_CHEAP_SNAPSHOT_TTL_MS=60000

# --- Multi-tenant Apify batching (docs/apify-multi-tenant-batching-plan.md) ---
# One Apify run serves every workspace tracking the same creator/hashtag.
# 0 disables batching entirely (one scrape per job) without a redeploy.
REFRESH_BATCHING_ENABLED=1
# Max PEER refresh jobs joined to one leader's scrape. Fan-out (persist +
# score + thumbnails per source) is serialized, so raise with DB_CONNECTION_LIMIT.
REFRESH_BATCH_PEER_CAP=9
# How long a queued refresh waits before ANY worker may claim it, so peers for
# the same canonical query accumulate and can share one scrape. Without this
# hold a 3s-idle worker claims each refresh alone and batching never fires.
# Costs nothing but latency; refresh is already a background operation.
REFRESH_COALESCE_MS=30000
# (No workspace-id config needed: a batched scrape's cost and cap check are
# split pro-rata across the workspaces in the batch — see splitSpend in
# src/lib/apify.ts.)

# --- Log shipping (indiestack, optional) ---
# Full https://<host>/log/<source-token> URL. Console output is batched and
# POSTed in the background every 30s; a dead endpoint is silently ignored
# (fail-open) and docker logs keep working regardless. Unset = disabled.
#INDIESTACK_LOG_URL=
# Flush interval in ms (default 30000).
#INDIESTACK_LOG_INTERVAL_MS=30000

# --- Deployment note: stop grace period ---
# SIGTERM sets a shutdown flag that is only checked BETWEEN jobs; the in-flight
# job runs to completion. A refresh batch is one ~170s scrape plus fan-out for
# up to REFRESH_BATCH_PEER_CAP+1 sources, so Docker's default 10s grace kills
# it mid-flight and leaves paid-for work half applied. Set
#   stop_grace_period: 300s      (compose)
#   docker run --stop-timeout 300
