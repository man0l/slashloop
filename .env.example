# ---------------------------------------------------------------------------
# Slashloop MCP Server — environment variables
# Copy this file to `.env` and fill in the values.
# All keys are optional for local mock-data development; live scraping and
# AI analysis require the corresponding keys below.
#
# IMPORTANT: NEVER commit .env. The included .gitignore protects it.
# When installing in Claude Code / OpenCode, set these same variables in
# the MCP server's `env` block of your client config (see README.md).
# ---------------------------------------------------------------------------

# ---- Database (optional override) ----
# Defaults to file:<repo>/prisma/slashloop.db if unset.
# DATABASE_URL=file:/absolute/path/to/slashloop.db

# ---- AI provider ----

# Google Gemini — REQUIRED for AI analysis.
# Powers both GeminiNativeAnalyzer (primary backend: uploads video, gets
# shots + audio + on-screen text in one call) AND GeminiTextAnalyzer
# (fallback when native video upload fails or yt-dlp is unavailable).
# Also powers hook-variation and brief generation.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Scrapers ----

# Apify — for TikTok and Instagram Reels scrapers (currently only TikTok is
# wired up via apify/tiktok-scraper). Get a token at
# https://console.apify.com/account/integrations
APIFY_API_KEY=

# YouTube Data API v3 — for YouTube Shorts scrapers (search.list, videos.list,
# channels.list). Not yet wired up. Get a key at
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ---- Spend controls (testing guardrails) ----

# Hard cap on monthly Apify spend, in cents. Default 500 = $5.
# When this is exceeded, refresh_source / discover_search will refuse the call,
# log a cap_breach event to UsageLog, and emit a stderr notification banner.
# Raise this once you move past testing.
APIFY_SPEND_CAP_CENTS=500

# Optional: notification hook fired when cap is breached. Leave empty to just
# log to stderr + UsageLog. Two formats accepted:
#   - URL starting with http:// or https:// -> we POST a JSON payload to it
#   - Any other string -> treated as a shell command, called as:
#       <hook> <workspaceId> <currentSpendCents> <capCents>
# Example URL: https://hooks.slack.com/services/XXX/YYY/ZZZ
# Example cmd: /usr/local/bin/notify-slack.sh
APIFY_CAP_NOTIFICATION_HOOK=
