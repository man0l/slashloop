# ---------------------------------------------------------------------------
# Slashloop — environment variables (remote HTTP MCP host)
# Copy this file to `.env` and fill in the values. Used by `bun run remote:dev`
# and the Vercel deployment. NEVER commit .env (.gitignore protects it).
# ---------------------------------------------------------------------------

# ---- Database (Postgres — Supabase) ----
# Use the pooler URL for serverless; DIRECT_URL (session mode) for migrations.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Remote MCP + Supabase OAuth (required for `bun run remote:dev` / Vercel) ----
# Public origin Claude Desktop reaches. For local tunnels use cloudflared/ngrok.
# PORT=8788
# PUBLIC_URL=https://your-tunnel-or-deploy.example
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLISHABLE_KEY


# ---- Media storage ----
# Persists TikTok cover images and MP4s so the feed doesn't render broken
# images once the source CDN's signed URLs expire. See
# docs/media-storage-plan.md. Backend selection (first match wins):
#   1. Cloudflare R2  — set R2_ENDPOINT + R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY
#   2. Supabase Storage — set SUPABASE_URL + SUPABASE_SECRET_KEY
# Leave both unset and the whole media path no-ops.

# --- Cloudflare R2 (preferred: free egress) ---
# Account R2 S3 endpoint + token from dashboard → R2 → Manage API Tokens.
#R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_ACCOUNT_ID=
#R2_THUMB_BUCKET=slashloop-thumbs
#R2_MEDIA_BUCKET=slashloop-media
# Public r2.dev (or custom domain) base for the thumbs bucket — no trailing slash.
#R2_THUMB_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev

# --- Supabase Storage (legacy / fallback) ---
# Supabase service/secret key (sb_secret_... or the legacy service_role JWT).
# Server-side only — never ship this to a browser. SUPABASE_ANON_KEY above is
# the browser key and does NOT have the permissions Storage writes need.
SUPABASE_SECRET_KEY=

# Bucket names when using Supabase (R2 uses R2_THUMB_BUCKET / R2_MEDIA_BUCKET).
STORAGE_THUMB_BUCKET=thumbs
STORAGE_MEDIA_BUCKET=media

# TTL for signed URLs to private video objects, in seconds. Default 86400 (24h).
MEDIA_SIGNED_URL_TTL_SECONDS=86400

# ---- Gallery links (/gallery) ----
# `show_gallery` publishes the gallery as an MCP App (a ui:// resource). That
# renders ONLY in hosts that declare the `io.modelcontextprotocol/ui` client
# extension — Claude Cowork and other Claude Code / Agent SDK hosts do not, and
# drop it silently. So the tool also returns a signed link to /gallery, which
# serves the identical HTML as an ordinary web page.
#
# OPTIONAL. Unset, the link is simply omitted (falls back to SUPABASE_SECRET_KEY
# then CRON_SECRET) — /gallery never becomes publicly readable without it.
# Server-side only; must NOT be the anon key.
GALLERY_LINK_SECRET=

# How long a minted gallery link stays valid, in seconds. Default 86400 (24h).
# It is a bearer credential to that user's gallery — keep it short.
GALLERY_LINK_TTL_SECONDS=86400

# Retention is a PER-WORKSPACE setting (Workspace.thumbRetentionDays /
# mediaRetentionDays), changed via the update_settings MCP tool. These two
# only seed NEW workspaces — changing them does not touch existing rows.
THUMB_RETENTION_DAYS_DEFAULT=3
MEDIA_RETENTION_DAYS_DEFAULT=3

# Absolute server-side ceiling on retention, above any plan's allowance.
# Backstop only; per-plan limits live in src/lib/retention.ts.
RETENTION_DAYS_MAX=90

# Shared secret for /api/cron/* routes. Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` once set on the project. Required — the
# retention sweep deletes media, so it must never be publicly invocable.
CRON_SECRET=

# ---- AI provider ----

# Google Gemini — REQUIRED for AI analysis.
# Powers both GeminiNativeAnalyzer (primary backend: uploads video, gets
# shots + audio + on-screen text in one call) AND GeminiTextAnalyzer
# (fallback when native video upload fails or yt-dlp is unavailable).
# Also powers hook-variation and brief generation.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- OpenRouter (optional text-model provider) ----

# Route text-model calls (gemini-text analysis, hook variations, briefs, source
# suggestions) through OpenRouter using the SAME Gemini models, selected by the
# factory in src/lib/llm.ts. When set, OpenRouter is preferred over
# GEMINI_API_KEY for text calls — keeps the service producing analyses even when
# the Google key is free-tier/quota'd (503/429) or absent. Gemıni-native video
# still needs GEMINI_API_KEY (OpenRouter has no Files-API upload equivalent).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional override of the OpenRouter base URL (defaults to
# https://openrouter.ai/api/v1).
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Force a provider for TEXT-model calls (hooks, briefs, suggestions, text
# analyses). Default (unset/auto) = OpenRouter when OPENROUTER_API_KEY exists,
# otherwise Google. Set 'google' or 'openrouter' to pin one.
#LLM_PROVIDER=auto

# OpenRouter VIDEO analysis (native, shot-level) — selected by the factory in
# src/lib/llm.ts and run by src/analysis/openrouter-video.ts. When set, the
# attempt chain becomes: google-native -> openrouter-video -> text, so the
# service keeps producing shot-level analyses on a billed OpenRouter key even
# when GEMINI_API_KEY is free-tier/quota'd or absent.
# Proven video-capable models (URL mode = provider fetches a signed Supabase
# URL; base64 mode = inline data URL):
#   qwen/qwen3.5-flash-02-23   URL+base64, fast, reliable
#   qwen/qwen3.7-flash         URL+base64, fast
#   bytedance-seed/seed-1.6-flash  URL+base64, fastest
#   stepfun/step-3.7-flash     URL+base64, richest output
#   z-ai/glm-5v-turbo          base64 only, cleanest JSON
#   z-ai/glm-4.6v              base64 only, accurate but slow
#   minimax/minimax-m3, xiaomi/mimo-v2.5  base64 only
# Mode: auto (url when the video is stored, else base64) | url | base64 | off
OPENROUTER_VIDEO_MODEL=qwen/qwen3.5-flash-02-23
OPENROUTER_VIDEO_MODE=auto

# ---- Scrapers ----

# Which adapter refresh/fetch/analyze use. Default is apify (the production
# path). Set to `proxy` to scrape TikTok directly through SCRAPER_PROXY_URL.
# Aliases for proxy: residential, proxy-cheap, direct, tiktok-web.
SCRAPER_PROVIDER=apify

# Rotating residential proxy. Required when SCRAPER_PROVIDER=proxy.
# Also the exclusive path for single-video MP4 downloads (fetch/analyze)
# whenever this is set — no Apify fallback.
# Accepts `user:pass@host:port` or a full URL. Never commit a real value.
# SCRAPER_PROXY_URL=

# Monthly proxy traffic ceiling in gigabytes (default 1). The adapter
# pre-authorises an estimate and refuses rather than going over.
# PROXY_TRAFFIC_CAP_GB=1

# Modelled COGS for proxy traffic, in cents per GB (default 300 = $3/GB).
# PROXY_COST_CENTS_PER_GB=300

# Refuse a single video download larger than this (default 12). Analysis
# and playback do not need the top bitrate rung.
# SCRAPER_PROXY_MAX_VIDEO_MB=12

# Force Chromium headless (1) or headful (0). Unset = headful on Windows,
# headless elsewhere. TikTok fingerprints HeadlessChrome and will not hydrate.
# SCRAPER_PROXY_HEADLESS=0

# Pin Proxy-Cheap geo (appended as `_country-XX` on the password). Default US.
# Empty string disables pinning. TikTok serves a discontinued page from IN/CN/HK.
# SCRAPER_PROXY_COUNTRY=US

# Proxy-Cheap dashboard API — used to read billed GB (GET /proxies).
# PROXY_CHEAP_API_KEY=
# PROXY_CHEAP_API_SECRET=

# Apify — for TikTok and Instagram Reels scrapers (currently only TikTok is
# wired up via clockworks/tiktok-scraper). Get a token at
# https://console.apify.com/account/integrations
APIFY_API_KEY=

# Optional: try a different TikTok actor FIRST instead of clockworks/tiktok-scraper
# (e.g. your own fork, actorId format "username~actor-name"). Every call still
# falls back to clockworks automatically if this actor's run fails — leave unset
# to just use clockworks directly. A fallback logs under the
# `[apify:actor-fallback]` tag so it's easy to find in Vercel logs.
APIFY_TIKTOK_ACTOR_ID=

# YouTube Data API v3 — for YouTube Shorts scrapers (search.list, videos.list,
# channels.list). Not yet wired up. Get a key at
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ---- Spend controls (testing guardrails) ----

# Hard cap on monthly Apify spend, in cents. Default 500 = $5.
# When this is exceeded, refresh_source / discover_search will refuse the call,
# log a cap_breach event to UsageLog, and emit a stderr notification banner.
# Raise this once you move past testing.
APIFY_SPEND_CAP_CENTS=500

# Optional: notification hook fired when cap is breached. Leave empty to just
# log to stderr + UsageLog. Two formats accepted:
#   - URL starting with http:// or https:// -> we POST a JSON payload to it
#   - Any other string -> treated as a shell command, called as:
#       <hook> <workspaceId> <currentSpendCents> <capCents>
# Example URL: https://hooks.slack.com/services/XXX/YYY/ZZZ
# Example cmd: /usr/local/bin/notify-slack.sh
APIFY_CAP_NOTIFICATION_HOOK=

# ---- Billing (Stripe) ----
# See docs/stripe-implementation-plan.md for the full setup: Stripe dashboard
# product/price creation and webhook registration. The CreditLedger/StripeEvent
# tables are created by the Supabase migration in supabase/migrations/, applied
# on merge — not by `db:push`.
#
# Dual-mode: both live and test secrets can be set at once. Flip with STRIPE_MODE
# (live|test). Default is live. App reads STRIPE_* when live, STRIPE_TEST_* when
# test — no need to overwrite secrets to switch.

# Public origin of the marketing/billing site (man0l/slashloop-site).
# Checkout success/cancel redirects and the Billing Portal return_url point
# here. No trailing slash.
SITE_URL=https://slashloop.app

# live (default) | test — which key set the app uses
STRIPE_MODE=live

# ---- Live mode (STRIPE_MODE=live) ----
# Secret key from https://dashboard.stripe.com/apikeys (sk_live_... / rk_live_...).
STRIPE_SECRET_KEY=

# Signing secret for the LIVE webhook endpoint on /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Live Price ids. Each subscription Price needs metadata plan_key + credits;
# pack needs pack_credits.
STRIPE_PRICE_CREATOR_MONTH=
STRIPE_PRICE_CREATOR_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_PACK=

# ---- Test mode (STRIPE_MODE=test) ----
# From dashboard Test mode keys, or `stripe listen --print-secret` for local
# webhook secret only (CLI secret does NOT work for the deployed URL).
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_CREATOR_MONTH=
STRIPE_TEST_PRICE_CREATOR_YEAR=
STRIPE_TEST_PRICE_PRO_MONTH=
STRIPE_TEST_PRICE_PRO_YEAR=
STRIPE_TEST_PRICE_PACK=
