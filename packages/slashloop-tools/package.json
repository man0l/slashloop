{
  "name": "slashloop-tools",
  "version": "0.1.0",
  "description": "Public free tools served at slashloop.dev/tools by a dedicated Cloudflare Worker.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
